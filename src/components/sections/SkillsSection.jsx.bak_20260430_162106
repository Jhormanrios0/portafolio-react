import {
  FaHtml5,
  FaCss3Alt,
  FaReact,
  FaBootstrap,
  FaNodeJs,
  FaGitAlt,
  FaGithub,
  FaNpm,
} from "react-icons/fa";
import {
  SiJavascript,
  SiTypescript,
  SiVite,
  SiTailwindcss,
  SiSass,
  SiGreensock,
  SiFramer,
  SiExpress,
  SiMysql,
  SiPostgresql,
  SiMongodb,
  SiFigma,
  SiPostman,
  SiVercel,
  SiNetlify,
} from "react-icons/si";
import { MdDevices } from "react-icons/md";
import { TbApi, TbWaveSine } from "react-icons/tb";

const skillGroups = [
  {
    number: "01",
    title: "Frontend",
    label: "Interface Layer",
    tools: [
      ["HTML", "Structure", FaHtml5],
      ["CSS", "Visual System", FaCss3Alt],
      ["JavaScript", "Logic", SiJavascript],
      ["TypeScript", "Typed Logic", SiTypescript],
      ["React", "Components", FaReact],
      ["Vite", "Build Tool", SiVite],
      ["Tailwind", "Utility CSS", SiTailwindcss],
      ["Sass", "CSS Pro", SiSass],
      ["Bootstrap", "UI System", FaBootstrap],
      ["Responsive UI", "Adaptive", MdDevices],
    ],
  },
  {
    number: "02",
    title: "Motion",
    label: "Experience Layer",
    tools: [
      ["GSAP", "Scroll Motion", SiGreensock],
      ["Lenis", "Smooth Scroll", TbWaveSine],
      ["Framer Motion", "Micro Motion", SiFramer],
    ],
  },
  {
    number: "03",
    title: "Backend / Data",
    label: "Connection Layer",
    tools: [
      ["Node.js", "Runtime", FaNodeJs],
      ["Express", "Server", SiExpress],
      ["APIs REST", "Services", TbApi],
      ["MySQL", "Database", SiMysql],
      ["PostgreSQL", "Relational DB", SiPostgresql],
      ["MongoDB", "NoSQL", SiMongodb],
    ],
  },
  {
    number: "04",
    title: "Workflow",
    label: "Delivery Layer",
    tools: [
      ["Git", "Versioning", FaGitAlt],
      ["GitHub", "Repositories", FaGithub],
      ["Figma", "Design", SiFigma],
      ["Postman", "API Testing", SiPostman],
      ["NPM", "Packages", FaNpm],
      ["Vercel", "Deploy", SiVercel],
      ["Netlify", "Deploy", SiNetlify],
    ],
  },
];

const skillCards = skillGroups.flatMap((group, groupIndex) =>
  group.tools.map(([name, meta, Icon], toolIndex) => ({
    id: `${group.title}-${name}`,
    name,
    meta,
    Icon,
    groupTitle: group.title,
    groupNumber: group.number,
    groupIndex,
    toolIndex,
  }))
);

export default function SkillsSection() {
  return (
    <div className="skills-orbit" data-skills-orbit>
      <div className="skills-orbit__paint" data-skills-paint aria-hidden="true" />

      <header className="skills-orbit__header">
        <p className="skills-orbit__eyebrow" data-skill-eyebrow>
          Stack técnico
        </p>

        <h2 className="skills-orbit__title" data-skill-title>
          Habilidades organizadas con criterio de producto.
        </h2>

        <p className="skills-orbit__intro" data-skill-intro>
          Un recorrido visual por las tecnologías que uso para construir
          interfaces modernas, animadas y listas para producción: estructura,
          movimiento, conexión con datos y flujo de entrega.
        </p>

        <div className="skills-orbit__timeline" data-skill-timeline>
          <span className="skills-orbit__timeline-line" aria-hidden="true">
            <span className="skills-orbit__timeline-fill" />
          </span>

          {skillGroups.map((group) => (
            <div className="skills-orbit__timeline-step" key={group.title}>
              <span>{group.number}</span>
              <strong>{group.title}</strong>
              <small>{group.label}</small>
            </div>
          ))}
        </div>
      </header>

      <div className="skills-orbit__stack" data-skills-stack>
        {skillCards.map((skill, index) => {
          const Icon = skill.Icon;

          return (
            <article
              className="skills-orbit-card"
              data-skill-card
              data-skill-phase={skill.groupIndex}
              key={skill.id}
              style={{
                "--card-index": index,
                "--float-delay": `${-(index % 9) * 0.32}s`,
                "--float-duration": `${5.4 + (index % 5) * 0.28}s`,
              }}
            >
              <div className="skills-orbit-card__inner">
                <span className="skills-orbit-card__phase">
                  {skill.groupNumber}
                </span>

                <span className="skills-orbit-card__icon">
                  <Icon />
                </span>

                <span className="skills-orbit-card__content">
                  <strong>{skill.name}</strong>
                  <small>{skill.meta}</small>
                </span>

                <span className="skills-orbit-card__group">
                  {skill.groupTitle}
                </span>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  );
}
