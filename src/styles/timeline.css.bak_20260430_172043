.portfolio-shell {
  position: relative;
  min-height: 100vh;
}

/* =========================
   Floating menu
========================= */

.floating-nav {
  position: fixed;
  inset: 0;
  z-index: 80;
  pointer-events: none;
}

.menu-fab {
  pointer-events: auto;
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 90;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 52px;
  padding: 8px 10px 8px 12px;
  border: 1px solid rgba(77, 163, 255, 0.24);
  border-radius: 999px;
  color: var(--color-text);
  background:
    linear-gradient(180deg, rgba(24, 24, 24, 0.86), rgba(10, 10, 10, 0.76)),
    rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(18px);
  box-shadow:
    0 22px 60px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
  cursor: pointer;
  overflow: hidden;
}

.menu-fab__glow {
  position: absolute;
  inset: -40%;
  background:
    radial-gradient(
      circle at 72% 20%,
      rgba(77, 163, 255, 0.22),
      transparent 34%
    ),
    radial-gradient(
      circle at 10% 90%,
      rgba(255, 255, 255, 0.08),
      transparent 30%
    );
  opacity: 0.9;
  pointer-events: none;
}

.menu-fab__current,
.menu-fab__label,
.menu-fab__icon {
  position: relative;
  z-index: 1;
}

.menu-fab__current {
  display: inline-grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 999px;
  color: #111;
  background: var(--color-primary);
  box-shadow: 0 0 24px rgba(77, 163, 255, 0.35);
  font-size: 0.76rem;
  font-weight: 950;
}

.menu-fab__label {
  font-size: 0.88rem;
  font-weight: 850;
}

.menu-fab__icon {
  display: grid;
  gap: 4px;
  width: 34px;
  height: 34px;
  place-content: center;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.07);
}

.menu-fab__bar {
  display: block;
  width: 15px;
  height: 2px;
  border-radius: 999px;
  background: var(--color-text);
  transform-origin: center;
}

.menu-backdrop {
  pointer-events: none;
  position: fixed;
  inset: 0;
  z-index: 81;
  border: 0;
  background:
    radial-gradient(
      circle at top right,
      rgba(77, 163, 255, 0.08),
      transparent 36%
    ),
    rgba(0, 0, 0, 0.18);
  backdrop-filter: blur(2px);
}

.menu-panel {
  pointer-events: none;
  position: fixed;
  top: 90px;
  right: 24px;
  z-index: 85;
  width: min(370px, calc(100vw - 32px));
  padding: 14px;
  border: 1px solid rgba(77, 163, 255, 0.18);
  border-radius: 28px;
  background:
    radial-gradient(
      circle at top right,
      rgba(77, 163, 255, 0.15),
      transparent 34%
    ),
    linear-gradient(180deg, rgba(22, 22, 22, 0.92), rgba(8, 8, 8, 0.9));
  backdrop-filter: blur(24px);
  box-shadow:
    0 32px 90px rgba(0, 0, 0, 0.48),
    inset 0 1px 0 rgba(255, 255, 255, 0.07);
  overflow: hidden;
}

.menu-panel::before {
  content: "";
  position: absolute;
  top: -80px;
  right: -70px;
  width: 190px;
  height: 190px;
  border-radius: 999px;
  background: rgba(77, 163, 255, 0.1);
  filter: blur(14px);
  pointer-events: none;
}

.menu-panel__header {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 10px 10px 14px;
}

.menu-panel__header span {
  display: block;
  margin-bottom: 4px;
  color: var(--color-primary);
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.menu-panel__header strong {
  display: block;
  color: var(--color-text);
  font-size: 1.18rem;
  letter-spacing: -0.03em;
}

.menu-panel__close {
  position: relative;
  flex: 0 0 auto;
  width: 38px;
  height: 38px;
  border: 1px solid var(--color-border);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.055);
  cursor: pointer;
}

.menu-panel__close span {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 15px;
  height: 2px;
  border-radius: 999px;
  background: var(--color-text);
}

.menu-panel__close span:first-child {
  transform: translate(-50%, -50%) rotate(45deg);
}

.menu-panel__close span:last-child {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.menu-panel__nav {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 8px;
}

.menu-panel__link {
  display: grid;
  grid-template-columns: 42px 1fr;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 11px;
  border: 1px solid transparent;
  border-radius: 18px;
  color: var(--color-muted);
  background: rgba(255, 255, 255, 0.035);
  text-align: left;
  cursor: pointer;
  transition:
    color 180ms ease,
    background 180ms ease,
    border-color 180ms ease,
    transform 180ms ease;
}

.menu-panel__link > span {
  display: inline-grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border-radius: 999px;
  color: var(--color-primary);
  background: rgba(77, 163, 255, 0.08);
  font-size: 0.76rem;
  font-weight: 950;
}

.menu-panel__link strong {
  display: block;
  margin-bottom: 3px;
  color: inherit;
  font-size: 0.94rem;
}

.menu-panel__link small {
  display: block;
  color: currentColor;
  opacity: 0.68;
  font-size: 0.76rem;
  font-weight: 700;
}

.menu-panel__link:hover,
.menu-panel__link.is-active {
  color: var(--color-text);
  border-color: rgba(77, 163, 255, 0.24);
  background: rgba(77, 163, 255, 0.09);
  transform: translateX(-3px);
}

.menu-panel__link.is-active > span {
  color: #111;
  background: var(--color-primary);
  box-shadow: 0 0 22px rgba(77, 163, 255, 0.28);
}

/* =========================
   Main layout
========================= */

.portfolio-main {
  min-height: 100vh;
  padding: 72px clamp(20px, 7vw, 110px) 120px;
}

.portfolio-header,
.timeline-content {
  margin-left: auto;
  margin-right: auto;
}

.portfolio-header {
  max-width: 1060px;
  margin-bottom: 76px;
}

.portfolio-header p {
  margin: 0 0 18px;
  width: fit-content;
  padding: 9px 14px;
  border: 1px solid rgba(77, 163, 255, 0.32);
  border-radius: 999px;
  color: var(--color-primary);
  background: rgba(77, 163, 255, 0.08);
  font-size: 0.9rem;
  font-weight: 800;
}

.portfolio-header h1 {
  margin: 0;
  max-width: 980px;
  font-size: clamp(3rem, 8vw, 7rem);
  line-height: 0.92;
  letter-spacing: -0.08em;
}

/* =========================
   Timeline wave
========================= */

.timeline-content {
  position: relative;
  isolation: isolate;
  display: grid;
  gap: 92px;
  max-width: 1080px;
}

.timeline-line {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 88px;
  overflow: visible;
  pointer-events: none;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.timeline-svg {
  display: block;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.timeline-path,
.timeline-path-progress {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.timeline-path {
  stroke: rgba(255, 255, 255, 0.13);
  stroke-width: 2.2;
}

.timeline-path-progress {
  stroke: var(--color-primary);
  stroke-width: 2.4;
  filter: drop-shadow(0 0 5px rgba(77, 163, 255, 0.32))
    drop-shadow(0 0 13px rgba(77, 163, 255, 0.16));
}

.timeline-traveler-dot {
  position: absolute;
  top: 0;
  left: 0;
  width: 14px;
  height: 14px;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow:
    0 0 0 6px rgba(77, 163, 255, 0.1),
    0 0 14px rgba(77, 163, 255, 0.38);
  pointer-events: none;
  z-index: 4;
  will-change: transform, opacity;
}

.timeline-section {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 88px minmax(0, 1fr);
  gap: 24px;
  min-height: 68vh;
  align-items: center;
  visibility: hidden;
}

.timeline-section__marker-wrap {
  position: relative;
  z-index: 3;
  display: flex;
  justify-content: center;
  transform: translateX(var(--marker-shift, 0px));
}

.timeline-section__marker {
  position: relative;
  z-index: 4;
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  border: 1px solid rgba(77, 163, 255, 0.42);
  color: #111;
  background: var(--color-primary);
  box-shadow:
    0 0 0 8px rgba(77, 163, 255, 0.08),
    0 0 18px rgba(77, 163, 255, 0.18);
  font-size: 0.78rem;
  font-weight: 950;
}

.timeline-section__marker span {
  display: block;
  line-height: 1;
}

.section-card,
.timeline-section__marker,
.timeline-reveal,
.timeline-path-progress {
  will-change: transform, opacity;
}

.section-card {
  position: relative;
  padding: clamp(24px, 4vw, 42px);
  border: 1px solid var(--color-border);
  border-radius: 30px;
  background:
    linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.07),
      rgba(255, 255, 255, 0.04)
    ),
    rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(18px);
  box-shadow: 0 20px 70px rgba(0, 0, 0, 0.26);
  overflow: hidden;
  transform-origin: center center;
}

.section-card::before {
  content: "";
  position: absolute;
  inset: -1px;
  pointer-events: none;
  background:
    radial-gradient(
      circle at top right,
      rgba(77, 163, 255, 0.12),
      transparent 34%
    ),
    radial-gradient(
      circle at bottom left,
      rgba(255, 255, 255, 0.04),
      transparent 28%
    );
}

.section-card > * {
  position: relative;
  z-index: 1;
}

.section-card__eyebrow {
  margin: 0 0 14px;
  color: var(--color-primary);
  font-size: 0.82rem;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: 0.16em;
}

.section-card h2 {
  margin: 0 0 18px;
  font-size: clamp(2rem, 4vw, 4rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
}

.section-card p {
  color: var(--color-muted);
  font-size: 1.05rem;
  line-height: 1.75;
}

.timeline-reveal {
  transform: translateZ(0);
}

/* =========================
   Section content
========================= */

.welcome__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.skills-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.skill-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42px;
  padding: 0 16px;
  border: 1px solid rgba(77, 163, 255, 0.18);
  border-radius: 999px;
  color: var(--color-text);
  background: rgba(77, 163, 255, 0.075);
  font-weight: 800;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 30px;
}

.mini-card {
  padding: 20px;
  border: 1px solid var(--color-border);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.045);
}

.mini-card h3 {
  margin: 0 0 10px;
  font-size: 1.08rem;
}

.mini-card p {
  margin: 0;
  font-size: 0.96rem;
}

.mini-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.mini-card__tags span {
  padding: 6px 9px;
  border-radius: 999px;
  color: var(--color-primary);
  background: rgba(77, 163, 255, 0.08);
  font-size: 0.78rem;
  font-weight: 800;
}

.experience-list {
  display: grid;
  gap: 16px;
  margin-top: 30px;
}

.experience-item {
  position: relative;
  padding: 22px;
  border: 1px solid var(--color-border);
  border-radius: 24px;
  background: linear-gradient(
    180deg,
    rgba(255, 255, 255, 0.06),
    rgba(255, 255, 255, 0.035)
  );
  overflow: hidden;
}

.experience-item::before {
  content: "";
  position: absolute;
  top: 24px;
  left: 0;
  width: 3px;
  height: calc(100% - 48px);
  border-radius: 999px;
  background: var(--color-primary);
  box-shadow: 0 0 18px rgba(77, 163, 255, 0.4);
}

.experience-item__header {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 14px;
}

.experience-item__header h3 {
  margin: 0 0 6px;
  font-size: 1.06rem;
}

.experience-item__header p {
  margin: 0;
  color: var(--color-muted);
  font-size: 0.94rem;
}

.experience-item__header span {
  flex: 0 0 auto;
  height: fit-content;
  padding: 7px 10px;
  border: 1px solid rgba(77, 163, 255, 0.22);
  border-radius: 999px;
  color: var(--color-primary);
  background: rgba(77, 163, 255, 0.08);
  font-size: 0.76rem;
  font-weight: 850;
}

.experience-item__description {
  position: relative;
  z-index: 1;
  margin: 0;
  font-size: 0.98rem;
}

.contact-box {
  display: grid;
  gap: 22px;
}

.contact-box .btn {
  width: fit-content;
}

/* =========================
   Responsive
========================= */

@media (max-width: 980px) {
  .portfolio-main {
    padding: 74px 20px 120px;
  }

  .menu-fab {
    top: 16px;
    right: 16px;
  }

  .menu-panel {
    top: 78px;
    right: 16px;
  }

  .timeline-content {
    gap: 78px;
  }

  .timeline-line {
    width: 68px;
  }

  .timeline-section {
    grid-template-columns: 68px minmax(0, 1fr);
    gap: 16px;
    min-height: auto;
    padding: 32px 0;
  }

  .timeline-section__marker {
    width: 40px;
    height: 40px;
    font-size: 0.72rem;
  }

  .cards-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 680px) {
  .experience-item__header {
    flex-direction: column;
  }

  .experience-item__header span {
    width: fit-content;
  }
}

@media (max-width: 560px) {
  .menu-fab {
    min-height: 48px;
    padding: 7px 8px;
  }

  .menu-fab__label {
    display: none;
  }

  .menu-fab__current,
  .menu-fab__icon {
    width: 32px;
    height: 32px;
  }

  .menu-panel {
    width: calc(100vw - 24px);
    right: 12px;
    top: 72px;
    border-radius: 24px;
  }

  .menu-panel__link {
    grid-template-columns: 38px 1fr;
    padding: 10px;
  }

  .menu-panel__link > span {
    width: 32px;
    height: 32px;
  }

  .portfolio-header h1 {
    letter-spacing: -0.05em;
  }

  .timeline-line {
    width: 54px;
  }

  .timeline-section {
    grid-template-columns: 54px minmax(0, 1fr);
    gap: 12px;
  }

  .timeline-section__marker {
    width: 36px;
    height: 36px;
    font-size: 0.68rem;
  }

  .timeline-traveler-dot {
    width: 12px;
    height: 12px;
  }

  .section-card {
    border-radius: 24px;
  }

  .welcome__actions,
  .contact-box .btn,
  .btn {
    width: 100%;
  }
}

/* =========================
   Marker life animation
========================= */

.timeline-section__marker {
  position: relative;
  overflow: visible;
  isolation: isolate;
  transform-origin: center;
  background: rgba(255, 255, 255, 0.055);
  color: rgba(255, 255, 255, 0.54);
  border-color: rgba(255, 255, 255, 0.16);
  box-shadow: 0 0 0 0 rgba(77, 163, 255, 0);
}

.timeline-section__marker span {
  position: relative;
  z-index: 2;
}

.timeline-section__marker-pulse {
  position: absolute;
  inset: -2px;
  z-index: 1;
  border-radius: inherit;
  border: 1px solid rgba(77, 163, 255, 0.7);
  background: rgba(77, 163, 255, 0.18);
  opacity: 0;
  transform: scale(0.65);
  pointer-events: none;
}

.timeline-section__marker::before {
  content: "";
  position: absolute;
  inset: 7px;
  z-index: 0;
  border-radius: inherit;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.12),
    transparent 68%
  );
  opacity: 0.55;
  pointer-events: none;
}

/* =========================
   Marker stronger GSAP animation
========================= */

.timeline-section__marker {
  position: relative;
  overflow: visible;
  isolation: isolate;
  transform-origin: center center;
  background: rgba(255, 255, 255, 0.055);
  color: rgba(255, 255, 255, 0.48);
  border-color: rgba(255, 255, 255, 0.16);
  box-shadow: 0 0 0 0 rgba(77, 163, 255, 0);
}

.timeline-section__marker span {
  position: relative;
  z-index: 3;
  display: block;
  transform-origin: center center;
  will-change: transform;
}

.timeline-section__marker-pulse {
  position: absolute;
  inset: -3px;
  z-index: 1;
  border-radius: inherit;
  border: 1px solid rgba(77, 163, 255, 0.9);
  background: radial-gradient(circle, rgba(77, 163, 255, 0.3), transparent 65%);
  opacity: 0;
  transform: scale(0.35);
  pointer-events: none;
  will-change: transform, opacity;
}

.timeline-section__marker::before {
  content: "";
  position: absolute;
  inset: 6px;
  z-index: 0;
  border-radius: inherit;
  background: radial-gradient(
    circle,
    rgba(255, 255, 255, 0.18),
    transparent 68%
  );
  opacity: 0.35;
  pointer-events: none;
}

.timeline-section__marker::after {
  content: "";
  position: absolute;
  inset: -9px;
  z-index: -1;
  border-radius: inherit;
  background: radial-gradient(
    circle,
    rgba(77, 163, 255, 0.28),
    transparent 64%
  );
  opacity: 0;
  filter: blur(8px);
  pointer-events: none;
  transition: opacity 260ms ease;
}

.timeline-section__marker[data-live="true"]::after {
  opacity: 1;
}

/* =========================
   Welcome cinematic section
========================= */

.section--welcome .section-card {
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  overflow: visible;
}

.section--welcome .section-card::before {
  display: none;
}

.section--welcome .section-card__eyebrow,
.section--welcome .section-card > h2 {
  display: none;
}

.welcome-cinematic {
  position: relative;
  isolation: isolate;
  min-height: 620px;
}

.welcome-hero {
  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.72fr);
  gap: clamp(24px, 4vw, 52px);
  align-items: center;
  min-height: 540px;
  padding: clamp(28px, 5vw, 58px);
  border: 1px solid rgba(77, 163, 255, 0.17);
  background:
    radial-gradient(
      circle at 18% 18%,
      rgba(77, 163, 255, 0.17),
      transparent 34%
    ),
    radial-gradient(
      circle at 88% 24%,
      rgba(255, 255, 255, 0.08),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.085),
      rgba(255, 255, 255, 0.035)
    ),
    rgba(8, 8, 8, 0.7);
  box-shadow:
    0 34px 110px rgba(0, 0, 0, 0.48),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.welcome-hero::before {
  content: "";
  position: absolute;
  inset: 1px;
  z-index: -1;
  border-radius: inherit;
  background:
    linear-gradient(120deg, rgba(77, 163, 255, 0.1), transparent 36%),
    radial-gradient(
      circle at bottom right,
      rgba(77, 163, 255, 0.1),
      transparent 30%
    );
  pointer-events: none;
}

.welcome-hero__content {
  position: relative;
  z-index: 2;
  min-width: 0;
}

.welcome-kicker {
  width: fit-content;
  margin: 0 0 22px;
  padding: 9px 13px;
  border: 1px solid rgba(77, 163, 255, 0.24);
  border-radius: 999px;
  color: var(--color-primary);
  background: rgba(77, 163, 255, 0.08);
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.welcome-title {
  display: grid;
  gap: 2px;
  margin: 0;
  max-width: 780px;
  font-size: clamp(3rem, 7vw, 6.6rem);
  line-height: 0.88;
  letter-spacing: -0.08em;
  color: var(--color-text);
  perspective: 900px;
}

.welcome-title-line {
  display: block;
  width: fit-content;
  transform-origin: left bottom;
  will-change: transform, opacity;
}

.welcome-title-line--accent {
  color: var(--color-primary);
  text-shadow: 0 0 34px rgba(77, 163, 255, 0.2);
}

.welcome-lead {
  max-width: 650px;
  margin: 26px 0 0;
