}

.skills-orbit-card__group {
  display: none;
  margin-top: 10px;
  color: rgba(var(--color-primary-rgb), 0.8);
  font-size: 0.58rem;
  font-weight: 950;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

@keyframes skills-card-float {
  0%,
  100% {
    transform: translate3d(0, 0, 0) rotate(0deg);
  }

  50% {
    transform: translate3d(0, -5px, 0) rotate(0.35deg);
  }
}

@media (max-width: 1120px) {
  .skills-orbit__stack {
    grid-template-columns: repeat(5, minmax(96px, 1fr));
  }
}

@media (max-width: 900px) {
  .skills-orbit__title {
    font-size: clamp(2rem, 9.5vw, 4.3rem);
  }

  .skills-orbit__timeline {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px 10px;
  }

  .skills-orbit__timeline-line {
    display: none;
  }

  .skills-orbit__stack {
    grid-template-columns: repeat(3, minmax(92px, 1fr));
  }
}

@media (max-width: 760px) {
  .section--skills {
    margin-top: 0 !important;
    padding-block: 76px !important;
  }

  .section--skills .section-card {
    min-height: auto !important;
  }

  .skills-orbit {
    position: relative;
    top: auto;
    height: auto;
    min-height: auto;
    transform: none;
    gap: 34px;
  }

  .skills-orbit__header {
    padding-inline: 0;
    text-align: left;
  }

  .skills-orbit__eyebrow {
    margin-inline: 0;
  }

  .skills-orbit__title,
  .skills-orbit__intro {
    margin-inline: 0;
  }

  .skills-orbit__timeline {
    width: 100%;
    margin-inline: 0;
  }

  .skills-orbit__timeline-step {
    align-items: start;
    justify-items: start;
  }

  .skills-orbit__stack {
    width: 100%;
    padding-inline: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .skills-orbit-card {
    min-height: 118px;
  }

  .skills-orbit-card__inner {
    animation: none;
  }
}

/* SKILLS_SCROLL_PERFORMANCE_END */

